    id, nome, apelido, posicao, idade, data_nascimento,
    cidade_nascimento, uf_nascimento, pais_nascimento,
    foto, time_id, competicao_id
) VALUES (
    -999,                     -- id (negativo, único)
    'Thayson Lourenço dos Santos',             -- nome
    'Thayson',                   -- apelido (opcional)
    'Atacante',               -- posicao
    16,                       -- idade (opcional, pode ser NULL)
    '2009-11-01',             -- data_nascimento (formato YYYY-MM-DD)
    '',                -- cidade_nascimento
    '',                     -- uf_nascimento
    'Brasil',                 -- pais_nascimento
    'Fotos_MYDB\Profissional\Capixaba Série B\Linhares\Thayson.png',                       -- foto (caminho ou vazio)
    12928,                    -- time_id (ID do time no banco)
    2                         -- competicao_id (ex: 1 = Série A)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
